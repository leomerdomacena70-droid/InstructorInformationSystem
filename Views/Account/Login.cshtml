@model InstructorInfoSystem.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="form-container">
    <div class="auth-icon"><i class="bi bi-mortarboard-fill"></i></div>
    <h2>Instructor Login</h2>
    <p class="form-lead">Welcome back. Please sign in to continue.</p>

    <form id="loginForm" asp-action="Login" method="post">
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="EmailOrId">Email or Instructor ID</label>
            <div class="input-icon">
                <i class="bi bi-person"></i>
                <input asp-for="EmailOrId" class="form-input" />
            </div>
            <span asp-validation-for="EmailOrId" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <div class="input-icon">
                <i class="bi bi-lock"></i>
                <input asp-for="Password" id="passwordField" class="form-input" />
            </div>
            <span asp-validation-for="Password" class="field-error"></span>
            <button type="button" id="togglePassword" class="btn-link">Show password</button>
        </div>

        <p id="jsMessage" class="js-message"></p>

        <button type="submit" class="btn-primary">Login</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
