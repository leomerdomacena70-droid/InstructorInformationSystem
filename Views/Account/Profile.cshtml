@{
    ViewData["Title"] = "My Profile";
    var initial = ((ViewBag.FirstName as string) ?? "?");
    initial = initial.Length > 0 ? initial.Substring(0, 1).ToUpper() : "?";
}

<div class="container" style="max-width: 820px;">

    <div class="card profile-card">
        <div class="profile-cover"></div>

        <div class="profile-head">
            <span class="avatar-xl">@initial</span>
            <div>
                <h3>@ViewBag.FirstName @ViewBag.LastName</h3>
                <p class="role">Registered User</p>
            </div>
        </div>

        <div class="profile-body">
            <p class="form-section-title mt-2 mb-1">Account Information</p>

            <div class="detail-grid">
                <div class="detail-row">
                    <span class="label">Account ID</span>
                    <span class="value">@ViewBag.AccountId</span>
                </div>
                <div class="detail-row">
                    <span class="label">Email Address</span>
                    <span class="value">@ViewBag.Email</span>
                </div>
                <div class="detail-row">
                    <span class="label">First Name</span>
                    <span class="value">@ViewBag.FirstName</span>
                </div>
                <div class="detail-row">
                    <span class="label">Last Name</span>
                    <span class="value">@ViewBag.LastName</span>
                </div>
            </div>

            <div class="alert alert-info d-flex gap-3 align-items-start mt-4 mb-4">
                <i class="bi bi-shield-lock fs-4"></i>
                <div>
                    <strong>Account Security</strong>
                    <p class="mb-0 mt-1">
                        Your password is stored as a secure hash and is
                        not displayed on this page.
                    </p>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Dashboard
                </a>

                <a asp-controller="Instructors"
                   asp-action="Index"
                   class="btn btn-primary">
                    Manage Instructors
                </a>
            </div>
        </div>
    </div>

</div>
