@model InstructorInfoSystem.Models.Instructor

@{
    ViewData["Title"] = "Add New Instructor";
}

<div class="container" style="max-width: 780px;">
    <div class="card overflow-hidden">
        <div class="form-card-header">
            <span class="eyebrow">New record</span>
            <h4 class="mb-0 fw-bold">Add New Instructor</h4>
        </div>

        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                <partial name="_InstructorFields" model="Model" />

                <button type="submit" class="btn btn-primary">
                    Save Instructor
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
